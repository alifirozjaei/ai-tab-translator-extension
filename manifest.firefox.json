{
  "manifest_version": 2,
  "name": "AI Tab Translator",
  "version": "0.1.0",
  "description": "Real-time AI voice translation for browser tab audio using your own Gemini API key.",
  "permissions": ["tabs", "activeTab", "storage", "<all_urls>", "https://generativelanguage.googleapis.com/*"],
  "background": { "scripts": ["service-worker.js", "offscreen-engine.js"], "type": "module", "persistent": true },
  "browser_action": { "default_popup": "popup/index.html", "default_title": "AI Tab Translator" },
  "options_ui": { "page": "settings/index.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
